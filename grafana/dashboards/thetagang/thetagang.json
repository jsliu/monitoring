  {
   "id": 11,
   "type": "barchart",
   "title": "Beta delta $ by symbol",
   "description": "What each symbol contributes to SPX delta",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sort_desc(sum by (symbol) (thetagang_symbol_beta_delta_dollars) != 0)",
     "legendFormat": "{{symbol}}",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "xField": "symbol",
    "showValue": "auto",
    "legend": {
     "showLegend": false
    }
   },
   "transformations": [
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "names": [
        "symbol",
        "Value"
       ]
      }
     }
    }
   ]
  },
  {
   "id": 12,
   "type": "table",
   "title": "Stress P&L (options repriced at current IV)",
   "description": "Each stock moves beta x the SPX move (betas=beta) or 1 x (betas=one). A big gap = the hedge leans on beta estimates.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (move, betas) (thetagang_stress_pnl)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "align": "right"
     }
    },
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "betas",
      "rowField": "move",
      "valueField": "Value"
     }
    }
   ]
  },
  {
   "id": 13,
   "type": "table",
   "title": "Symbols",
   "description": "Net greeks of all stock and option positions per symbol",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (symbol) (thetagang_symbol_beta)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "sum by (symbol) (thetagang_symbol_delta_shares)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "sum by (symbol) (thetagang_symbol_delta_dollars)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "D",
     "expr": "sum by (symbol) (thetagang_symbol_beta_delta_dollars)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "E",
     "expr": "sum by (symbol) (thetagang_symbol_theta)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "F",
     "expr": "sum by (symbol) (thetagang_symbol_vega)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "Delta \\$|Beta delta \\$|Theta.*|Vega.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "currencyUSD"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Beta"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 2
       }
      ]
     }
    ]
   },
   "options": {},
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "Beta",
       "Value #B": "Delta (shares)",
       "Value #C": "Delta $",
       "Value #D": "Beta delta $",
       "Value #E": "Theta $/day",
       "Value #F": "Vega $/pt"
      }
     }
    }
   ]
  },
  {
   "id": 14,
   "type": "table",
   "title": "Positions",
   "description": "P&L ratio: share of the premium captured (shorts) or gained (longs); rolls/closes key off it",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (instrument, symbol, kind) (thetagang_position_quantity)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "sum by (instrument, symbol, kind) (thetagang_position_avg_price)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "sum by (instrument, symbol, kind) (thetagang_position_price)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "D",
     "expr": "sum by (instrument, symbol, kind) (thetagang_position_unrealized_pnl)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "E",
     "expr": "sum by (instrument, symbol, kind) (thetagang_position_pnl_ratio)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "F",
     "expr": "sum by (instrument, symbol, kind) (thetagang_position_dte)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Unrealized P&L"
      },
      "properties": [
       {
        "id": "unit",
        "value": "currencyUSD"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "green",
           "value": 0
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "P&L ratio"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "decimals",
        "value": 1
       }
      ]
     }
    ]
   },
   "options": {},
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "Qty",
       "Value #B": "Avg price",
       "Value #C": "Price",
       "Value #D": "Unrealized P&L",
       "Value #E": "P&L ratio",
       "Value #F": "DTE"
      }
     }
    }
   ]
  },
  {
