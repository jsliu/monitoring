   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum(thetagang_net_liquidation)",
     "legendFormat": "net liq",
     "instant": true,
     "range": false
