  {
   "id": 8,
   "type": "table",
   "title": "Review queue (every strategy not on HOLD, highest priority first)",
   "description": "The Portfolio Manager's review signals (vault rules) next to what the bot's own rules say. Click a strategy for its detail below.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 14
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (strategy, symbol, kind, cls, outcome, top, signals, bot) (thetagang_pm_info{outcome!=\"HOLD\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "sum by (strategy) (thetagang_pm{field=\"priority\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "sum by (strategy) (thetagang_pm{field=\"v_exec\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "D",
     "expr": "sum by (strategy) (thetagang_pm{field=\"pnl_exec\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "E",
     "expr": "sum by (strategy) (thetagang_pm{field=\"dte_front\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "F",
     "expr": "sum by (strategy) (thetagang_pm{field=\"dte_window\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "strategy",
      "mode": "inner"
     }
    },
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "pattern": "^(?!(Time.*|Value #A)$).*$"
      }
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "strategy": "Strategy",
       "symbol": "Symbol",
       "kind": "Kind",
       "cls": "Class",
       "top": "Priority",
       "outcome": "PM outcome",
       "signals": "Signals",
       "bot": "Bot rules say",
       "Value #B": "rank",
       "Value #C": "Exec value ($)",
       "Value #D": "P&L exec ($)",
       "Value #E": "DTE",
       "Value #F": "Review at DTE"
      },
      "indexByName": {
       "strategy": 0,
       "top": 1,
       "outcome": 2,
       "signals": 3,
       "bot": 4,
       "cls": 5,
       "kind": 6,
       "Value #C": 7,
       "Value #D": 8,
       "Value #E": 9,
       "Value #F": 10,
       "symbol": 11,
       "Value #B": 12
      },
      "excludeByName": {
       "symbol": true
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "rank",
      "desc": true
     }
    ]
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "minWidth": 50,
      "align": "auto"
     },
     "noValue": " "
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Strategy"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open ${__value.raw}",
          "url": "/d/thetagang-pm/portfolio-manager?var-strategy=${__value.raw}&${__url_time_range}"
         }
        ]
       },
       {
        "id": "custom.width",
        "value": 200
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Priority"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "P0": {
            "color": "red",
            "index": 0
           },
           "P1": {
            "color": "orange",
            "index": 1
           },
           "P2": {
            "color": "yellow",
            "index": 2
           },
           "-": {
            "color": "green",
            "text": "\u2013",
            "index": 3
           }
          }
         }
        ]
       },
       {
        "id": "custom.width",
        "value": 70
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "PM outcome"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "regex",
          "options": {
           "pattern": "^CLOSE.*",
           "result": {
            "color": "red",
            "index": 0
           }
          }
         },
         {
          "type": "regex",
          "options": {
           "pattern": ".*data unreliable",
           "result": {
            "color": "purple",
            "index": 1
           }
          }
         },
         {
          "type": "regex",
          "options": {
           "pattern": "^REVIEW.*",
           "result": {
            "color": "orange",
            "index": 2
           }
          }
         },
         {
          "type": "regex",
          "options": {
           "pattern": "^HOLD",
           "result": {
            "color": "green",
            "index": 3
           }
          }
         }
        ]
       },
       {
        "id": "custom.width",
        "value": 190
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
