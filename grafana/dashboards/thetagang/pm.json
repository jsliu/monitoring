      "type": "grafana-postgresql-datasource",
      "uid": "journal"
     },
     "refId": "A",
     "rawSql": "SELECT to_char(at AT TIME ZONE 'America/New_York', 'YYYY-MM-DD HH24:MI') AS \"When (NY)\", outcome AS \"PM outcome\", (SELECT string_agg((e->>'priority') || ' ' || (e->>'name') || ': ' || (e->>'detail'), '; ')  FROM jsonb_array_elements(signals) e) AS \"Signals\", bot_action AS \"Bot rules said\", your_action AS \"You did\" FROM decisions WHERE strategy_id = '$strategy' ORDER BY at DESC LIMIT 100",
