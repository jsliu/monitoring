    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "sum(thetagang_pretrade_risk{measure=\"neutrality\",scenario=\"after\"})",
     "legendFormat": "After",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
