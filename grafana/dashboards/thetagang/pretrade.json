{
 "uid": "thetagang-pretrade",
 "title": "thetagang pre-trade",
 "tags": [
  "thetagang",
  "nautilus"
 ],
 "schemaVersion": 41,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 2
   },
   "options": {
    "mode": "markdown",
    "content": "**Pre-trade**: what proposed trades do to the portfolio, while `thetagang-nt pretrade` waits for your y/N (`deploy/pretrade.sh` in the thetagang repo). Empty when nothing is being proposed. *After* = held positions + the proposal, computed with the same code as the main dashboard."
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "thetagang_pretrade_status",
     "legendFormat": "{{status}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "no proposal",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "awaiting.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "sent.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "graphMode": "none",
    "textMode": "name",
    "colorMode": "value",
    "orientation": "horizontal",
    "justifyMode": "center",
    "text": {
     "titleSize": 22
    },
    "wideLayout": true
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Total cost",
   "description": "Sum of qty x mid x multiplier over the proposal: + pays (debit), - receives (credit)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 2,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum(thetagang_pretrade_trade{field=\"cost\"})",
     "legendFormat": "cost",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "graphMode": "none",
    "textMode": "value",
    "colorMode": "value",
    "orientation": "horizontal",
    "justifyMode": "center",
    "text": {},
    "wideLayout": true
   }
  },
  {
   "id": 4,
