      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum(thetagang_pretrade_risk{measure=\"neutrality\",scenario=\"now\"})",
     "legendFormat": "Now",
     "instant": true,
     "range": false
