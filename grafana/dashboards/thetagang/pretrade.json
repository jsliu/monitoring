{
 "uid": "thetagang-pretrade",
 "title": "thetagang pre-trade",
 "tags": [
  "thetagang",
  "nautilus"
 ],
 "schemaVersion": 41,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 2
   },
   "options": {
    "mode": "markdown",
    "content": "**Pre-trade**: your **[[pretrade.candidates]]**, each sized on its own to bring SPX delta to 0, compared with **Now**. The trading strategy refreshes this every `refresh_mins` (15) during market hours; `deploy/pretrade.sh` shows fresh numbers here while it runs and is how you send one."
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "(thetagang_pretrade_status{job=\"thetagang-pretrade\"} or ignoring(job, instance) thetagang_pretrade_status{job=\"thetagang-strategy\"})",
     "legendFormat": "{{status}}",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "topk(1, last_over_time(thetagang_pretrade_choice{job=\"thetagang-pretrade\"}[730d]))",
     "legendFormat": "Last choice: {{choice}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "no proposal",
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "sent.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "(cancelled|stale|nothing|no trade).*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "Last choice.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "graphMode": "none",
    "textMode": "name",
    "colorMode": "value",
    "justifyMode": "center",
    "text": {
     "valueSize": 20
    },
    "orientation": "horizontal"
   },
   "description": "Top: the live pretrade run if one is up, else the trading strategy's background comparison. Bottom: your last answer to ./pretrade.sh (NY time), kept until you answer again."
  },
  {
   "id": 8,
   "type": "stat",
   "title": "SPX",
   "description": "SPX index level now: the 0 point of the SPX P&L curve.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 2,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "thetagang_spx_price{job=\"thetagang\"}",
     "instant": true,
     "range": false,
     "legendFormat": "SPX"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   }
  },
  {
   "id": 9,
   "type": "stat",
   "title": "VIX",
   "description": "VIX now, the market's 30-day at-the-money implied vol of SPX: the 0 point of the VIX P&L curve.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 9,
    "y": 2,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "thetagang_vix_price{job=\"thetagang\"}",
     "instant": true,
     "range": false,
     "legendFormat": "VIX"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Distance from SPX delta neutral: now and after each candidate",
   "description": "|Beta delta $| in neutral bands. 0 = neutral at the centre; up to 1 = neutral; up to 2 = drifting; beyond = off neutral. The colour runs continuously green -> yellow -> red (yellow around 6 bands, orange around 10, full red from 20).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 2,
    "w": 12,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (scenario) ((thetagang_pretrade_risk{job=\"thetagang-pretrade\",measure=\"Distance from neutral (x band)\"} or ignoring(job, instance) thetagang_pretrade_risk{job=\"thetagang-strategy\",measure=\"Distance from neutral (x band)\"}))",
     "legendFormat": "{{scenario}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "suffix:\u00d7 band",
     "decimals": 1,
     "min": 0,
     "max": 20,
     "color": {
      "mode": "continuous-GrYlRd"
     },
     "mappings": [
      {
       "type": "special",
       "options": {
        "match": "nan",
        "result": {
         "text": "no band",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "now"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Now"
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "graphMode": "none",
    "textMode": "value_and_name",
    "colorMode": "background",
    "justifyMode": "center",
    "orientation": "vertical",
    "text": {
     "titleSize": 13,
     "valueSize": 20
    }
   }
  },
  {
   "id": 6,
   "type": "xychart",
   "title": "Theoretical P&L by SPX price",
   "description": "The portfolio's P&L if SPX were at each price (from -10% to +10% of today's, 1% apart): each stock moves beta x the SPX move, options repriced with Black-Scholes at their current implied vol. 'Now' is the portfolio as it is; each other line adds that candidate's orders. Zero at today's SPX price.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 11
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "label_replace(sum by (scenario, spx) ((thetagang_pretrade_curve{job=\"thetagang-pretrade\"} or ignoring(job, instance) thetagang_pretrade_curve{job=\"thetagang-strategy\"})), \"scenario\", \"Now\", \"scenario\", \"now\")",
     "instant": true,
     "range": false,
     "format": "table",
     "legendFormat": ""
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "scenario",
      "rowField": "spx",
      "valueField": "Value"
     }
    },
    {
     "id": "convertFieldType",
     "options": {
      "conversions": [
       {
        "targetField": "spx\\scenario",
        "destinationType": "number"
       }
      ]
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "spx\\scenario"
       }
      ]
     }
    },
    {
     "id": "organize",
     "options": {
      "indexByName": {
       "spx\\scenario": 0,
       "Now": 1
      },
      "renameByName": {
       "spx\\scenario": "SPX"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 0,
     "custom": {
      "show": "lines",
      "lineWidth": 2,
      "pointSize": {
       "fixed": 5
      },
      "axisPlacement": "auto",
      "axisLabel": "P&L"
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "SPX"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.axisLabel",
        "value": "SPX"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Now"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ffffff"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "mapping": "auto",
    "series": [
     {
      "x": {
       "matcher": {
        "id": "byName",
        "options": "SPX"
       }
      }
     }
    ],
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "pluginVersion": "13.2.4"
  },
  {
   "id": 7,
   "type": "xychart",
   "title": "Theoretical P&L by VIX level",
   "description": "The portfolio's P&L if VIX were at each level (\u221210 to +20 points from now, not below 9) with SPX unchanged, now and after each candidate. Every option's implied vol moves by the same vol points as VIX; VIX options' underlying moves with VIX. Single stocks' IV usually moves less than VIX, so this overstates their vega P&L.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 11
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "label_replace(sum by (scenario, vix) ((thetagang_pretrade_vix_curve{job=\"thetagang-pretrade\"} or ignoring(job, instance) thetagang_pretrade_vix_curve{job=\"thetagang-strategy\"})), \"scenario\", \"Now\", \"scenario\", \"now\")",
     "instant": true,
     "range": false,
     "format": "table",
     "legendFormat": ""
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "scenario",
      "rowField": "vix",
      "valueField": "Value"
     }
    },
    {
     "id": "convertFieldType",
     "options": {
      "conversions": [
       {
        "targetField": "vix\\scenario",
        "destinationType": "number"
       }
      ]
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "vix\\scenario"
       }
      ]
     }
    },
    {
     "id": "organize",
     "options": {
      "indexByName": {
       "vix\\scenario": 0,
       "Now": 1
      },
      "renameByName": {
       "vix\\scenario": "VIX"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 0,
     "custom": {
      "show": "lines",
      "lineWidth": 2,
      "pointSize": {
       "fixed": 5
      },
      "axisPlacement": "auto",
      "axisLabel": "P&L"
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "VIX"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.axisLabel",
        "value": "VIX"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Now"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ffffff"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "mapping": "auto",
    "series": [
     {
      "x": {
       "matcher": {
        "id": "byName",
        "options": "VIX"
       }
      }
     }
    ],
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "pluginVersion": "13.2.4"
  },
  {
   "id": 4,
   "type": "table",
   "title": "Portfolio greeks: now and after each candidate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 16
   },
   "description": "SPX beta-weighted: 'Now' is the portfolio as it is, each other column the portfolio after that candidate's orders (sized to bring SPX delta to 0). Below the greeks: the neutral band, the distance from neutral in bands, gamma P&L on an expected day, net carry (theta + gamma P&L), the break-even daily move (max: short gamma, bigger days lose; min: long gamma, smaller days lose; '\u2013' where it doesn't apply), and the candidate's cost (+ pay, - receive).",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "label_join(sum by (measure, scenario, row) ((thetagang_pretrade_risk{job=\"thetagang-pretrade\",measure!~\"Stress.*|Neutrality\"} or ignoring(job, instance) thetagang_pretrade_risk{job=\"thetagang-strategy\",measure!~\"Stress.*|Neutrality\"})), \"key\", \" \", \"row\", \"measure\")",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "scenario",
      "rowField": "key",
      "valueField": "Value"
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "key\\scenario"
       }
      ]
     }
    },
    {
     "id": "organize",
     "options": {
      "indexByName": {
       "key\\scenario": 0,
       "now": 1
      },
      "renameByName": {
       "key\\scenario": "Greek",
       "now": "Now"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 2,
     "custom": {
      "align": "right",
      "minWidth": 110
     },
     "mappings": [
      {
       "type": "special",
       "options": {
        "match": "nan",
        "result": {
         "text": "\u2013",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Greek"
      },
      "properties": [
       {
        "id": "custom.align",
        "value": "left"
       },
       {
        "id": "custom.width",
        "value": 310
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "regex",
          "options": {
           "pattern": "^\\d+ (.*)$",
           "result": {
            "text": "$1",
            "index": 0
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "cellHeight": "sm"
   }
  },
  {
   "id": 5,
   "type": "table",
   "title": "Orders of each candidate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 51,
    "w": 24,
    "h": 6
   },
   "description": "Order: side, quantity and contract per leg (a spread is one combo order). Limit: net mid per unit (negative = credit). Cost: + you pay, - you receive. Units 0 with a note: left out.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (scenario, trade, contracts) ((thetagang_pretrade_trade{job=\"thetagang-pretrade\",field=\"qty\"} or ignoring(job, instance) thetagang_pretrade_trade{job=\"thetagang-strategy\",field=\"qty\"}))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "sum by (scenario, trade, contracts) ((thetagang_pretrade_trade{job=\"thetagang-pretrade\",field=\"price\"} or ignoring(job, instance) thetagang_pretrade_trade{job=\"thetagang-strategy\",field=\"price\"}))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "sum by (scenario, trade, contracts) ((thetagang_pretrade_trade{job=\"thetagang-pretrade\",field=\"cost\"} or ignoring(job, instance) thetagang_pretrade_trade{job=\"thetagang-strategy\",field=\"cost\"}))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "trade": true
      },
      "indexByName": {
       "scenario": 0,
       "contracts": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #A": 4
      },
      "renameByName": {
       "scenario": "Candidate",
       "contracts": "Order (enter at the limit)",
       "Value #A": "Units",
       "Value #B": "Limit (net mid)",
       "Value #C": "Cost"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Candidate"
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Units"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.width",
        "value": 80
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Limit (net mid)"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 2
       },
       {
        "id": "custom.width",
        "value": 130
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Candidate"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 200
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Cost"
      },
      "properties": [
       {
        "id": "unit",
        "value": "currencyUSD"
       },
       {
        "id": "decimals",
        "value": 1
       },
       {
        "id": "custom.width",
        "value": 110
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "red",
           "value": 0.5
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "cellHeight": "sm"
   }
  }
 ],
 "links": [
  {
   "title": "thetagang",
   "type": "link",
   "url": "/d/thetagang",
   "icon": "dashboard"
  }
 ]
}
