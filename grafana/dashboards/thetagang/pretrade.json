  {
   "id": 11,
   "type": "table",
   "title": "Proposed trades",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 14,
    "h": 9
   },
   "description": "Price: net mid per unit (negative is a credit). Cost: qty x price x multiplier.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (trade, contracts) (thetagang_pretrade_trade{field=\"qty\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "sum by (trade, contracts) (thetagang_pretrade_trade{field=\"price\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "sum by (trade, contracts) (thetagang_pretrade_trade{field=\"cost\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "trade": 0,
       "contracts": 1,
       "Value #A": 2,
       "Value #B": 3,
       "Value #C": 4
      },
      "renameByName": {
       "trade": "Trade",
       "contracts": "Contracts",
       "Value #A": "Qty",
       "Value #B": "Price",
       "Value #C": "Cost"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Qty"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Price"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Cost"
      },
      "properties": [
       {
        "id": "unit",
        "value": "currencyUSD"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true
   }
  },
  {
   "id": 12,
   "type": "table",
   "title": "Stress P&L by SPX move",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 12,
    "w": 10,
    "h": 9
   },
   "description": "Beta-weighted: each stock moves beta x the SPX move; options repriced at current IV.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(sum by (measure, scenario) (thetagang_pretrade_risk{measure=~\"stress_.*\"}), \"row\", \"1\", \"measure\", \"stress_-10%\"), \"row\", \"2\", \"measure\", \"stress_-5%\"), \"row\", \"3\", \"measure\", \"stress_-1%\"), \"row\", \"4\", \"measure\", \"stress_\\\\+1%\"), \"row\", \"5\", \"measure\", \"stress_\\\\+5%\"), \"row\", \"6\", \"measure\", \"stress_\\\\+10%\")",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "scenario",
      "rowField": "row",
      "valueField": "Value"
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "row\\scenario"
       }
      ]
     }
    },
    {
     "id": "calculateField",
     "options": {
      "mode": "binary",
      "binary": {
       "left": "after",
       "operator": "-",
       "right": "now"
      },
      "alias": "Change",
      "replaceFields": false
     }
    },
    {
     "id": "organize",
     "options": {
      "indexByName": {
       "row\\scenario": 0,
       "now": 1,
       "after": 2,
       "Change": 3
      },
      "renameByName": {
       "row\\scenario": "SPX move",
       "now": "Now",
       "after": "After"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0
       }
      ]
     },
     "custom": {
      "align": "center",
      "cellOptions": {
       "type": "color-text"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "SPX move"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       },
       {
        "id": "custom.align",
        "value": "left"
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "-10%",
            "index": 0
           },
           "2": {
            "text": "-5%",
            "index": 1
           },
