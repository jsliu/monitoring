   "title": "SPX delta neutrality",
   "description": "Neutral: |beta delta $| within the band; drifting: up to twice it; off neutral: beyond",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 2,
    "w": 12,
