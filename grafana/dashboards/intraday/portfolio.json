      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 2,
        "x": 22,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "im_last_bar_age_seconds",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
