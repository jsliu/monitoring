    {
      "type": "row",
      "title": "History",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": [],
      "id": 18
    },
    {
      "type": "timeseries",
      "title": "Net liquidation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ib_net_liquidation_usd{account=\"$account\"})",
          "legendFormat": "net liq"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 19
    },
    {
      "type": "timeseries",
      "title": "Drawdown vs. trailing peak (look-back = the visible range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(ib_net_liquidation_usd{account=\"$account\"}) / max_over_time(sum(ib_net_liquidation_usd{account=\"$account\"})[$__range:$__interval]) - 1)",
          "legendFormat": "drawdown %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "id": 20
    },
    {
      "type": "barchart",
      "title": "Daily P&L at the 16:00 New York close",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (day) (last_over_time(ib_close_pnl_usd{account=\"$account\"}[$__range]))",
          "legendFormat": "{{day}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "day",
        "showValue": "never",
        "legend": {
          "showLegend": false
        }
      },
      "id": 21,
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "day"
              }
            ]
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "account",
        "label": "Account",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(ib_net_liquidation_usd, account)", "refId": "account"},
        "definition": "label_values(ib_net_liquidation_usd, account)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  }
}
