{
  "uid": "im-portfolio",
  "title": "Intraday paper book",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "America/New_York",
  "refresh": "15s",
  "time": {
    "from": "now-1d",
    "to": "now"
  },
  "tags": [
    "intraday"
  ],
  "panels": [
    {
      "type": "row",
      "title": "Account",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Net liquidation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ib_net_liquidation_usd{account=\"$account\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "type": "stat",
      "title": "Today's P&L",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ib_daily_pnl_usd{account=\"$account\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Margin used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(ib_maint_margin_usd{account=\"$account\"}) / sum(ib_net_liquidation_usd{account=\"$account\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "type": "stat",
      "title": "Available funds",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ib_available_funds_usd{account=\"$account\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "type": "stat",
      "title": "IB connected",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ib_up)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO",
                  "color": "red"
                },
                "1": {
                  "text": "yes",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "row",
      "title": "Positions by leg",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": [],
      "id": 7
    },
    {
      "type": "table",
      "title": "Open positions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ib_position_qty{account=\"$account\"}",
          "legendFormat": "qty",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "ib_position_market_value_usd{account=\"$account\"}",
          "legendFormat": "value",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "ib_position_unrealized_pnl_usd{account=\"$account\"}",
          "legendFormat": "unrealized",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Market value by leg",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (leg) (ib_position_market_value_usd{account=\"$account\"})",
          "legendFormat": "{{leg}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 9
    },
    {
      "type": "row",
      "title": "Momentum node",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": [],
      "id": 10
    },
    {
      "type": "stat",
      "title": "State",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "im_state",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "waiting",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "warming up",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "watching",
                  "index": 2
                }
              }
            },
            {
              "type": "value",
              "options": {
                "3": {
                  "text": "in position",
                  "index": 3
                }
              }
            },
            {
              "type": "value",
              "options": {
                "4": {
                  "text": "exited",
                  "index": 4
                }
              }
            },
            {
              "type": "value",
              "options": {
                "5": {
                  "text": "no trade",
                  "index": 5
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Move vs. trigger",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 4,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "im_move_pct",
          "legendFormat": "move %"
        },
        {
          "refId": "B",
          "expr": "im_threshold_pct",
          "legendFormat": "trigger %"
        },
        {
          "refId": "C",
          "expr": "-im_threshold_pct",
          "legendFormat": "-trigger %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "id": 12
    },
    {
      "type": "stat",
      "title": "Net units",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 2,
