# Copy to monitoring/.env (git-ignored) and fill in. Never commit the real file.
# Telegram: create a bot with @BotFather (token), send it a message, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates ("chat":{"id": ...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Grafana login (user admin) at http://localhost:3000. Grafana takes it at its first start only (it is then kept in
# the grafana-data volume): change it later in Grafana's UI. Avoid $ in values here (docker compose would expand
# it), or wrap the value in single quotes.
GF_SECURITY_ADMIN_PASSWORD=
